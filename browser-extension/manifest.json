{
  "manifest_version": 3,
  "name": "Dynamic Island Browser Media Bridge",
  "version": "1.0.0",
  "description": "Shares browser playback metadata with the Dynamic Island desktop widget.",
  "permissions": ["scripting"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:47821/*"],
  "background": {"service_worker": "service-worker.js"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]
}
